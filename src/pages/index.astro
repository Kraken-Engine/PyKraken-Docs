---
import Icon from "../components/Icon.astro";
import Layout from "../layouts/Layout.astro";
import { url, guideGroups, api } from "../lib/content";
---

<Layout>
  <main id="main">
    <aside class="development-banner" aria-label="Documentation status">
      <p>
        <strong>These docs are still a work in progress.</strong>
        They're published early to keep the API reference and guides up to date while
        the site takes shape. Thanks for bearing with the rough edges.
      </p>
    </aside>
    <section class="home-hero">
      <div class="hero-copy">
        <div class="eyebrow">
          <span class="version-tag">v{api.versions.python}</span>
        </div>
        <h1>
          Build the game,<br /><span class="highlight">not the groundwork.</span
          >
        </h1>
        <p>Build your next 2D game with Kraken, in Python or C++.</p>
        <div class="hero-buttons">
          <a
            class="button primary"
            href={url("guides/getting-started/create-window/")}
            >Make your first window <span><Icon name="arrow-up-right" /></span
            ></a
          ><a class="button secondary" href={url("api/")} data-api-link
            >Explore the API <span><Icon name="arrow-right" /></span></a
          >
        </div>
        <div class="install-line">
          <span>$</span><code>pip install kraken-engine</code><button
            data-copy="pip install kraken-engine"
            aria-label="Copy installation command">Copy</button
          >
        </div>
      </div>
      <div class="hero-art">
        <div class="game-window">
          <div class="window-bar">
            <span><i></i><i></i><i></i></span><span>demo.py</span>
          </div>
          <div class="game-scene">
            <video
              id="hero-demo"
              width="960"
              height="585"
              poster={url("images/kraken-tidepool.png")}
              data-src={url("videos/kraken-tidepool.mp4")}
              muted
              loop
              playsinline
              preload="none"
              aria-label="A kraken follows a paper boat beneath rippling teal water, rendered with Kraken."
            ></video>
          </div>
          <div class="window-bottom">
            Rendered with Kraken
            <button id="hero-playback" aria-controls="hero-demo" hidden
              >Pause animation</button
            >
          </div>
        </div>
      </div>
    </section>
    <div class="chapter-strip">
      <span>OPEN THE MANUAL</span><span>01 / LEARN</span><span
        >02 / EXPERIMENT</span
      ><span>03 / MAKE IT YOURS</span><span><Icon name="arrow-down" /></span>
    </div>
    <section class="home-chapters">
      <div class="section-heading">
        <div>
          <span class="eyebrow">PICK A STARTING POINT</span><h2>
            A little help along the way.
          </h2>
        </div><a class="text-link" href={url("guides/")}
          >All guides <span><Icon name="arrow-up-right" /></span></a
        >
      </div>
      <div class="chapter-grid">
        {
          guideGroups.map((group, i) => (
            <a
              class={`chapter-card ${group.color}`}
              href={url(`guides/${group.slug}/`)}
            >
              <>
                <span class="chapter-number">CHAPTER 0{i + 1}</span>
                <span class="chapter-icon" aria-hidden="true">
                  <Icon
                    name={(["book", "rendering", "input", "code"] as const)[i]}
                  />
                </span>
                <h3>{group.title}</h3>
                <p>
                  {
                    [
                      "Set things up, open a window, and draw your first frame.",
                      "Put shapes, textures, and a little color on the screen.",
                      "Give your world movement, text, and animation.",
                      "Get to know the small programs behind your pixels.",
                    ][i]
                  }
                </p>
                <span class="card-arrow" aria-hidden="true">
                  <Icon name="arrow-up-right" />
                </span>
              </>
            </a>
          ))
        }
      </div>
    </section>
    <section class="reference-banner">
      <span class="reference-symbol" aria-hidden="true"
        ><Icon name="code" /></span
      ><div>
        <span class="eyebrow">ALREADY KNOW WHAT YOU NEED?</span><h2>
          Keep the reference close.
        </h2><p>
          Signatures, parameters, and return types. Straight from the engine.
        </p>
      </div><a class="button secondary" href={url("api/")} data-api-link
        >Open API reference <Icon name="arrow-right" /></a
      >
    </section>
  </main>
</Layout>

<style>
  .development-banner {
    padding: 16px clamp(24px, 5vw, 72px);
    border-bottom: 1px solid var(--line);
    background: var(--notice-background, var(--yellow));
    color: var(--ink);
  }

  :global(html[data-theme="dark"]) .development-banner {
    --notice-background: #233330;
    color: var(--muted);
  }

  :global(html[data-theme="dark"]) .development-banner strong {
    color: var(--ink);
  }

  .development-banner p {
    max-width: 85ch;
    margin: 0 auto;
    font-size: 14px;
    line-height: 1.6;
    text-align: center;
  }
</style>

<script>
  const video = document.querySelector<HTMLVideoElement>("#hero-demo");
  const playback = document.querySelector<HTMLButtonElement>("#hero-playback");
  if (video && playback) {
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const updateLabel = () => {
      playback.textContent = video.paused
        ? "Play animation"
        : "Pause animation";
    };
    const applyMotionPreference = () => {
      playback.hidden = reducedMotion.matches;
      if (reducedMotion.matches) {
        video.pause();
        video.removeAttribute("src");
        video.load();
      } else {
        video.muted = true;
        video.src = video.dataset.src!;
        void video.play().catch(updateLabel);
      }
    };
    video.addEventListener("play", updateLabel);
    video.addEventListener("pause", updateLabel);
    playback.addEventListener("click", () => {
      if (video.paused) void video.play().catch(updateLabel);
      else video.pause();
    });
    reducedMotion.addEventListener("change", applyMotionPreference);
    applyMotionPreference();
  }
</script>

<style>
  .game-scene video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 640 / 390;
    object-fit: cover;
    background: #2b504f;
  }
  #hero-playback {
    margin-left: auto;
    padding: 0;
    background: transparent;
    color: var(--muted);
    font-size: 10px;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
